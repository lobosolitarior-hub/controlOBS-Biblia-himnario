doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no")
    meta(name="apple-mobile-web-app-capable", content="yes")
    meta(name="apple-mobile-web-app-status-bar-style", content="black-translucent")
    meta(name="theme-color", content="#0b0f19")
    title= title
    link(rel="stylesheet", href="/css/remoto.css")
  body.remote-body
    //- =========================================================
    //- BARRA SUPERIOR: ESTADO OBS + QR + CONFIGURACIÓN
    //- =========================================================
    header.remote-topbar
      .topbar-brand#btnObsConfig(title="Configurar conexión OBS WebSocket")
        span#obsStatusDot.status-dot(class=obsConnected ? 'connected' : 'disconnected')
        .brand-titles
          span.brand-main Control OBS Remoto
          span#obsStatusText.brand-sub= obsConnected ? 'OBS Conectado' : 'OBS Desconectado (toca para conectar)'
      .topbar-actions
        button#btnToggleMonitor.top-icon-btn.active(type="button", title="Mostrar/Ocultar Monitor en Vivo") 📺 Monitor
        button#btnOpenQrModal.top-icon-btn(type="button", title="Ver Código QR e IP para Celular/Tablet") 📱 QR
        button#btnOpenConfigModal.top-icon-btn(type="button", title="Ajustes de OBS") ⚙️

    //- =========================================================
    //- TARJETA DE BIENVENIDA Y QR EN PC DE CABINA (NO TÉCNICOS)
    //- Se muestra automáticamente al abrir desde el icono de Escritorio
    //- =========================================================
    section#desktopHubBanner.desktop-hub-section(hidden)
      .desktop-hub-card
        .desktop-hub-header
          div
            span.hub-badge 🖥️ PANEL DE CABINA • CONEXIÓN FÁCIL
            h2.hub-title Conecta tu Celular o Tablet sin cables
          button#btnHideDesktopHub.pill-action-btn(type="button", title="Ocultar este asistente") Ocultar ✕
        .desktop-hub-grid
          .hub-qr-column
            .hub-qr-frame
              img#hubQrImg(alt="Código QR para Celular/Tablet")
            span.hub-qr-caption 📱 Escanea con la cámara de tu celular (en el mismo Wi-Fi)
          .hub-actions-column
            .hub-step
              strong 1. Dirección para tu Celular o Tablet:
              .hub-url-row
                span#hubMobileUrlText http://localhost:3000/remoto
                button#btnHubCopyMobileUrl.pill-action-btn.accent(type="button") 📋 Copiar
            .hub-step
              strong 2. Conexión con OBS Studio y Audios MP3:
              .hub-btn-group
                button#btnHubOpenSettings.hub-action-btn.primary(type="button") ⚙️ Configurar OBS y Escenas
                button#btnHubOpenMp3.hub-action-btn(type="button") 📂 Abrir Carpeta para pegar MP3
            .hub-step
              strong 3. Enlaces rápidos para Fuentes de Navegador en OBS:
              .hub-obs-links
                button.pill-action-btn(type="button", data-copy-path="/proyeccion") 📋 Copiar URL Himnario
                button.pill-action-btn(type="button", data-copy-path="/biblia") 📋 Copiar URL Biblia
                button.pill-action-btn(type="button", data-copy-path="/panel") 📋 Copiar URL Dock OBS
                button#btnHubQuitApp.pill-action-btn.danger(type="button", title="Cierra el servidor en segundo plano para poder actualizar o desinstalar sin bloqueos") 🛑 Cerrar por completo (Actualizar/Desinstalar)

    //- =========================================================
    //- MONITOR EN VIVO DE LA SALIDA DE OBS (COLAPSABLE)
    //- =========================================================
    section#liveMonitorSection.live-monitor-section
      .monitor-frame
        img#obsPreviewImg.monitor-img(alt="Vista en vivo de OBS", hidden)
        #monitorPlaceholder.monitor-placeholder
          span.placeholder-icon 🎥
          span#monitorPlaceholderText Esperando imagen de OBS Studio...
        .monitor-badges-top
          span#badgeProgramScene.monitor-badge.scene-badge Escena: —
          span#badgeStreamStatus.monitor-badge.stream-badge(hidden) 🔴 EN VIVO 00:00:00
          span#badgeRecordStatus.monitor-badge.rec-badge(hidden) ⏺️ REC 00:00:00
        .monitor-badges-bottom
          span#badgeActiveProjection.monitor-badge.proj-badge(hidden) 📖 Proyectando
          button#btnPauseMonitor.monitor-mini-btn(type="button") ⏸ Pausar video

    //- =========================================================
    //- CONTENIDO PRINCIPAL POR PESTAÑAS
    //- =========================================================
    main.remote-main
      //- -------------------------------------------------------
      //- PESTAÑA 1: ESCENAS Y FUENTES DE OBS
      //- -------------------------------------------------------
      section#tab-escenas.tab-panel.active
        .panel-card
          .card-head
            h2.card-title 🎬 Escenas de OBS Studio
            .card-head-actions
              button#btnStudioModeToggle.pill-action-btn(type="button") Modo Estudio: OFF
              button#btnStudioTransition.pill-action-btn.accent(type="button", hidden) 🔄 Transición
          #scenesGrid.scenes-grid
            .empty-hint Conéctate a OBS Studio para ver y cambiar tus escenas aquí.

        .panel-card
          .card-head
            h2.card-title 👁️ Fuentes en la Escena Actual
            span#currentSceneSourcesLabel.card-subtitle Mostrar u ocultar cámaras, imágenes y diapositivas
          #sceneItemsList.scene-items-list
            .empty-hint Selecciona una escena para administrar sus elementos.

        .panel-card
          .card-head
            h2.card-title 📡 Transmisión y Grabación
            span.card-subtitle Con confirmación de seguridad
          .stream-controls-grid
            button#btnToggleStream.stream-ctrl-btn(type="button")
              span.ctrl-icon 📡
              .ctrl-info
                strong#lblStreamBtn Iniciar Transmisión
                small#subStreamBtn Estado: Detenido
            button#btnToggleRecord.stream-ctrl-btn(type="button")
              span.ctrl-icon ⏺️
              .ctrl-info
                strong#lblRecordBtn Iniciar Grabación
                small#subRecordBtn Estado: Detenido

      //- -------------------------------------------------------
      //- PESTAÑA 2: TECLADO REMOTO Y ATAJOS PERSONALIZABLES
      //- -------------------------------------------------------
      section#tab-teclas.tab-panel
        .panel-card
          .card-head
            div
              h2.card-title ⌨️ Control de Diapositivas y Teclas
              span.card-subtitle Re Pág, Av Pág, PowerPoint, Keynote, Canva y OBS
            button#btnManageShortcuts.pill-action-btn.accent(type="button") ✏️ Configurar Teclas

          //- Selector rápido de aplicación destino opcional
          .target-app-bar
            label(for="quickTargetAppSelect") Enviar a:
            select#quickTargetAppSelect.remote-select
              option(value="") Ventana activa actual ( + Hotkey OBS )
              option(value="Microsoft PowerPoint") Microsoft PowerPoint
              option(value="Keynote") Apple Keynote
              option(value="OBS") OBS Studio
              option(value="Google Chrome") Google Chrome (Canva / Slides)
              option(value="Safari") Safari
              option(value="Preview") Vista Previa (PDF)
              option(value="VLC") VLC Media Player

          //- Retroalimentación de última tecla enviada
          #lastKeyFeedback.key-feedback(hidden)
            span#lastKeyText Tecla enviada: Av Pág

          //- Cuadrícula de botones de atajos (100% personalizables)
          #shortcutsGrid.shortcuts-grid

        //- Envío directo de cualquier tecla o texto en caliente
        .panel-card
          .card-head
            h2.card-title ⚡ Enviar Tecla Rápida o Texto
          .quick-key-row
            input#customRawKeyInput.remote-input(
              type="text",
              placeholder="Escribe una letra, número o tecla (ej: F5, Space, b)..."
            )
            button#btnSendRawKey.btn-primary-action(type="button") Enviar

        //- Panel editor de atajos personalizados (visible al tocar "Configurar Teclas")
        #shortcutsEditorCard.panel-card(hidden)
          .card-head
            h2.card-title ⚙️ Personalizar Botones en Pantalla
            .card-head-actions
              button#btnNewShortcut.pill-action-btn.accent(type="button") ➕ Nuevo Atajo
              button#btnResetShortcuts.pill-action-btn.danger(type="button") Restaurar
          p.helper-note Agrega, edita o elimina las teclas que quieras tener en tu celular/tablet.
          #shortcutsEditorList.shortcuts-editor-list

      //- -------------------------------------------------------
      //- PESTAÑA 3: MULTIMEDIA (VIDEOS/IMÁGENES) Y AUDIO OBS
      //- -------------------------------------------------------
      section#tab-multimedia.tab-panel
        .panel-card
          .card-head
            h2.card-title 🎞️ Control de Videos y Fuentes Multimedia
            button#btnRefreshMedia.pill-action-btn(type="button") 🔄 Actualizar
          #mediaInputsList.media-inputs-list
            .empty-hint No se detectaron videos activos en OBS.

        .panel-card
          .card-head
            h2.card-title 🎚️ Mezclador de Audio OBS
            span.card-subtitle Silenciar o ajustar volumen en vivo
          #audioMixerList.audio-mixer-list
            .empty-hint Conecta OBS para controlar micrófonos y audio.

      //- -------------------------------------------------------
      //- PESTAÑA 4: HIMNARIO ADVENTISTA (614 HIMNOS)
      //- -------------------------------------------------------
      section#tab-himnario.tab-panel
        .panel-card
          .card-head
            div
              h2.card-title 🎵 Himnario Adventista (1 - 614)
              span.card-subtitle Sincronizado con OBS Studio
            .audio-badges-row
              span#hymnBadgeCantado.mini-badge 🎤 Cantado
              span#hymnBadgeInstr.mini-badge 🎹 Pista

          .hymn-search-grid
            .hymn-num-box
              label(for="remHymnNum") N.º
              input#remHymnNum.remote-input.num-input(
                type="number",
                min="1",
                max="614",
                placeholder="1-614"
              )
            .hymn-title-box
              label(for="remHymnSearch") Buscar por título o número
              .search-wrap
                input#remHymnSearch.remote-input(
                  type="text",
                  placeholder="Ej: Cantad alegres, 1, Santo...",
                  autocomplete="off"
                )
                button#btnRemClearHymn.clear-x(type="button", hidden) ✕
                ul#remHymnAutocomplete.dropdown-list(hidden)

          //- Modos de reproducción y avance
          .hymn-options-row
            .segmented-group#remAudioModeGroup
              button.seg-btn.active(type="button", data-mode="cantado") 🎤 Cantado
              button.seg-btn(type="button", data-mode="instrumental") 🎹 Pista
              button.seg-btn(type="button", data-mode="letra") 📄 Letra
            .segmented-group#remAdvanceModeGroup
              button.seg-btn.active(type="button", data-advance="auto") ⚡ Auto
              button.seg-btn(type="button", data-advance="manual") 🖐️ Manual

          //- Botones principales de acción del Himno
          .hymn-main-actions
            button#btnRemHymnProject.btn-big-action.play(type="button") ▶ Proyectar Himno
            button#btnRemHymnPause.btn-big-action.pause(type="button", disabled) ⏯ Pausa
            button#btnRemHymnStop.btn-big-action.stop(type="button", disabled) ⏹ Detener

          //- Barra de tiempo del audio del himno
          #remHymnProgressBox.hymn-progress-box(hidden)
            .progress-labels
              span#remHymnTimeCurrent 0:00
              span#remHymnActiveTitle En proyección
              span#remHymnTimeTotal 0:00
            input#remHymnSeekRange.seek-slider(type="range", min="0", max="100", value="0", step="0.5")

          //- Navegación grande de diapositivas del himno (< Anterior | Siguiente >)
          .slide-nav-big
            button#btnRemPrevSlide.slide-nav-btn(type="button", disabled) ⬅️ Estrofa Anterior
            button#btnRemNextSlide.slide-nav-btn(type="button", disabled) Siguiente Estrofa ➡️

        .panel-card
          .card-head
            h2.card-title#remHymnPreviewHeader 📜 Diapositivas del Himno
            span.card-subtitle Toca cualquier estrofa para proyectarla al instante
          #remHymnSlidesList.hymn-slides-list

      //- -------------------------------------------------------
      //- PESTAÑA 5: SANTA BIBLIA (RVR1960 / DHH)
      //- -------------------------------------------------------
      section#tab-biblia.tab-panel
        .panel-card
          .card-head
            div
              h2.card-title 📖 Santa Biblia en Vivo
              span#remBibleTag.card-subtitle Génesis 1:1 (RVR1960)
            .segmented-group#remBibleVersionGroup
              button.seg-btn.active(type="button", data-version="RVR1960") RVR60
              button.seg-btn(type="button", data-version="DHH") DHH

          //- Buscador inteligente de cita bíblica
          .search-wrap.bible-search-wrap
            input#remBibleSearch.remote-input(
              type="text",
              placeholder="Escribe cita: Juan 3:16, Éxodo 20:8, Salmos 23...",
              autocomplete="off"
            )
            button#btnRemClearBible.clear-x(type="button", hidden) ✕
            ul#remBibleAutocomplete.dropdown-list(hidden)

          //- Selectores directos de Libro y Capítulo para usar cómodamente en celular/tablet
          .bible-selectors-row
            select#remBibleBookSelect.remote-select
            select#remBibleChapterSelect.remote-select

          //- Escena destino (Fondo o Cámara) + Acciones
          .bible-controls-row
            .segmented-group#remBibleSceneGroup
              button.seg-btn.active(type="button", data-scene="fondo") 🖼️ Escena Fondo
              button.seg-btn(type="button", data-scene="camara") 🎥 Escena Cámara
            .bible-action-btns
              button#btnRemBibleProject.btn-big-action.play(type="button") ▶ Proyectar
              button#btnRemBibleStop.btn-big-action.stop(type="button", disabled) ⏹ Ocultar

          //- Botones grandes para cambiar de versículo (< Anterior | Siguiente >)
          .slide-nav-big
            button#btnRemPrevVerse.slide-nav-btn(type="button") ⬅️ Versículo Anterior
            button#btnRemNextVerse.slide-nav-btn(type="button") Siguiente Versículo ➡️

        .panel-card
          .card-head
            h2.card-title 📑 Versículos del Capítulo
            span.card-subtitle Toca un versículo para enviarlo a OBS
          ul#remBibleVersesList.bible-verses-list-mobile

    //- =========================================================
    //- BARRA DE NAVEGACIÓN INFERIOR (ESTILO APP MÓVIL / TABLET)
    //- =========================================================
    nav.bottom-tabbar
      button.tab-btn.active(type="button", data-tab="tab-escenas")
        span.tab-icon 🎬
        span.tab-label Escenas
      button.tab-btn(type="button", data-tab="tab-teclas")
        span.tab-icon ⌨️
        span.tab-label Teclas/PPT
      button.tab-btn(type="button", data-tab="tab-multimedia")
        span.tab-icon 🎞️
        span.tab-label Videos/Audio
      button.tab-btn(type="button", data-tab="tab-himnario")
        span.tab-icon 🎵
        span.tab-label Himnario
      button.tab-btn(type="button", data-tab="tab-biblia")
        span.tab-icon 📖
        span.tab-label Biblia

    //- =========================================================
    //- MODAL 1: CREAR / EDITAR ATAJO DE TECLADO PERSONALIZADO
    //- =========================================================
    #shortcutModal.remote-modal(hidden)
      form#shortcutForm.remote-modal-card
        .modal-header
          h3#shortcutModalTitle ➕ Configurar Atajo de Tecla
          button#btnCloseShortcutModal.modal-close(type="button") ✕
        .modal-body
          input#scIdInput(type="hidden")
          .form-row
            label Nombre en el botón
            input#scLabelInput.remote-input(type="text", placeholder="Ej: Av Pág, Iniciar PPT, Cámara 1...", required)
          .form-grid-2
            .form-row
              label Icono / Emoji
              input#scIconInput.remote-input(type="text", placeholder="⏭️", value="⌨️")
            .form-row
              label Tamaño del botón
              select#scSizeInput.remote-select
                option(value="large") Grande (Destacado)
                option(value="normal") Normal
          .form-row
            label Tecla a enviar
            .key-capture-row
              select#scKeySelect.remote-select
                optgroup(label="Navegación y Presentaciones")
                  option(value="PageUp") Re Pág (PageUp)
                  option(value="PageDown") Av Pág (PageDown)
                  option(value="Right") Flecha Derecha (Right)
                  option(value="Left") Flecha Izquierda (Left)
                  option(value="Down") Flecha Abajo (Down)
                  option(value="Up") Flecha Arriba (Up)
                  option(value="Space") Espacio (Space)
                  option(value="Enter") Enter / Intro
                  option(value="Escape") Escape (Esc)
                  option(value="Home") Inicio (Home)
                  option(value="End") Fin (End)
                  option(value="Tab") Tabulador (Tab)
                  option(value="Backspace") Borrar (Backspace)
                optgroup(label="Teclas de Función (F1 - F12)")
                  option(value="F1") F1
                  option(value="F2") F2
                  option(value="F3") F3
                  option(value="F4") F4
                  option(value="F5") F5 (Iniciar Presentación)
                  option(value="F6") F6
                  option(value="F7") F7
                  option(value="F8") F8
                  option(value="F9") F9
                  option(value="F10") F10
                  option(value="F11") F11 (Pantalla Completa)
                  option(value="F12") F12
                optgroup(label="Letras y Números")
                  option(value="A") Letra A
                  option(value="B") Letra B (Pantalla Negra PPT)
                  option(value="C") Letra C
                  option(value="D") Letra D
                  option(value="E") Letra E
                  option(value="F") Letra F
                  option(value="G") Letra G
                  option(value="H") Letra H
                  option(value="I") Letra I
                  option(value="J") Letra J
                  option(value="K") Letra K
                  option(value="L") Letra L
                  option(value="M") Letra M
                  option(value="N") Letra N
                  option(value="O") Letra O
                  option(value="P") Letra P
                  option(value="Q") Letra Q
                  option(value="R") Letra R
                  option(value="S") Letra S
                  option(value="T") Letra T
                  option(value="U") Letra U
                  option(value="V") Letra V
                  option(value="W") Letra W (Pantalla Blanca PPT)
                  option(value="X") Letra X
                  option(value="Y") Letra Y
                  option(value="Z") Letra Z
                  option(value="1") Número 1
                  option(value="2") Número 2
                  option(value="3") Número 3
                  option(value="4") Número 4
                  option(value="5") Número 5
                  option(value="6") Número 6
                  option(value="7") Número 7
                  option(value="8") Número 8
                  option(value="9") Número 9
                  option(value="0") Número 0
              button#btnCaptureKey.pill-action-btn(type="button", title="Presiona una tecla física para detectarla") 🎹 Detectar
          .form-row
            label Teclas modificadoras (combinación opcional)
            .modifiers-row
              label.check-pill
                input#modCtrl(type="checkbox", value="ctrl")
                span Ctrl
              label.check-pill
                input#modAlt(type="checkbox", value="alt")
                span Alt / Option
              label.check-pill
                input#modShift(type="checkbox", value="shift")
                span Shift
              label.check-pill
                input#modCmd(type="checkbox", value="cmd")
                span Cmd / Win
          .form-grid-2
            .form-row
              label Color del botón
              select#scColorInput.remote-select
                option(value="primary") Azul (Principal)
                option(value="secondary") Índigo / Violeta
                option(value="emerald") Verde Esmeralda
                option(value="amber") Ámbar / Dorado
                option(value="danger") Rojo
                option(value="slate") Gris Pizarra
            .form-row
              label Destino
              select#scTargetInput.remote-select
                option(value="both") Sistema + OBS Hotkey
                option(value="os") Solo Sistema (PPT/Apps)
                option(value="obs") Solo Hotkey OBS
        .modal-footer
          button#btnCancelShortcut.pill-action-btn(type="button") Cancelar
          button.btn-primary-action(type="submit") 💾 Guardar Atajo

    //- =========================================================
    //- MODAL 2: CÓDIGO QR Y ENLACE PARA CELULAR / TABLET
    //- =========================================================
    #qrModal.remote-modal(hidden)
      .remote-modal-card
        .modal-header
          h3 📱 Conectar Celular o Tablet
          button#btnCloseQrModal.modal-close(type="button") ✕
        .modal-body.qr-modal-body
          p.qr-instructions Escanea este código QR con la cámara de tu celular o tablet (conectado al mismo Wi-Fi de la iglesia):
          .qr-box
            img#qrImage(alt="Código QR para conectar celular")
          .qr-url-box
            span#qrUrlText http://localhost:3000/remoto
            button#btnCopyQrUrl.pill-action-btn.accent(type="button") 📋 Copiar
          .modal-footer(style="width:100%;justify-content:space-between")
            button#btnQrToSettings.pill-action-btn(type="button") ⚙️ Ir a Configuraciones de OBS
            button#btnQrDone.btn-primary-action(type="button") Listo

    //- =========================================================
    //- MODAL 3: CONFIGURACIÓN DE CONEXIÓN OBS WEBSOCKET
    //- (Incluye el área de créditos del autor idéntica al proyecto anterior)
    //- =========================================================
    #configModal.remote-modal(hidden)
      form#obsConfigForm.remote-modal-card
        .modal-header
          h3 ⚙️ Conexión OBS WebSocket y Escenas
          button#btnCloseConfigModal.modal-close(type="button") ✕
        .modal-body
          .form-row
            label Servidor OBS WebSocket (IP y Puerto)
            input#obsUrlInput.remote-input(type="text", placeholder="ws://127.0.0.1:4455", value=obsConfig.url)
          .form-row
            label Contraseña de OBS WebSocket
            input#obsPassInput.remote-input(type="password", placeholder="Dejar vacío si no tiene contraseña", value=obsConfig.password)
          .form-grid-2
            .form-row
              label Escena de Himnario
              input#obsSceneInput.remote-input(type="text", placeholder="Himnario", value=obsConfig.sceneName)
            .form-row
              label Escena Biblia (Fondo)
              input#obsBibleBgInput.remote-input(type="text", placeholder="Biblia", value=obsConfig.bibleBgSceneName)
          .form-grid-2
            .form-row
              label Escena Biblia (Cámara)
              input#obsBibleCamInput.remote-input(type="text", placeholder="Biblia Camara", value=obsConfig.bibleCamSceneName)
            .form-row
              label Segundos por diapo (Solo letra)
              input#obsSoloLetraSecInput.remote-input(type="number", min="3", max="60", value=obsConfig.soloLetraIntervalSec)
          .form-row
            label Carpeta de audios MP3 (Cantado / Instrumental)
            input#obsAudioRootInput.remote-input(type="text", value=obsConfig.audioRootDir)

          .modal-footer(style="margin-top:6px;justify-content:space-between;flex-wrap:wrap")
            button#btnOpenAudioFolder.pill-action-btn(type="button") 📂 Carpeta MP3
            button#btnResetFactoryConfig.pill-action-btn(type="button", title="Restaurar configuración original") 🧹 Restaurar Ajustes
            button.btn-primary-action(type="submit") Guardar y Conectar

          .maintenance-row(style="display:flex;justify-content:center;margin-top:6px")
            button#btnQuitAppFromModal.pill-action-btn.danger(type="button", style="width:100%") 🛑 Cerrar programa por completo (Para Actualizar o Desinstalar)

          .modal-author-credit
            strong.modal-author-name Ing. Rubén Humberto Armendáriz Tamayo
            span.modal-author-degree Ingeniero en Sistemas Computacionales
            span.modal-author-date Octubre - 2026
            a.modal-author-btn(href="/autor") 🙏 Página del Autor / Agradecer

    script(src="/socket.io/socket.io.js")
    script(src="/js/remoto.js")
