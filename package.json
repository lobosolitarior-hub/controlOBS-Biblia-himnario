{
  "name": "control-obs-remoto",
  "productName": "Control OBS Remoto",
  "version": "1.0.3",
  "description": "Centro de Control Remoto Inalámbrico (Celular / Tablet) para OBS Studio con Monitor en Vivo, Escenas, Teclado/Atajos Personalizables, Multimedia, Santa Biblia (RVR1960/DHH) e Himnario Adventista (614 himnos)",
  "author": "Ing. Rubén Humberto Armendáriz Tamayo <lobosolitarior@gmail.com>",
  "license": "MIT",
  "main": "electron-main.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "app": "electron .",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win --x64",
    "dist:all": "electron-builder --mac --win --x64"
  },
  "dependencies": {
    "express": "^4.19.2",
    "obs-websocket-js": "^5.0.5",
    "pug": "^3.0.3",
    "qrcode": "^1.5.4",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.7.5"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "org.adventista.controlobsremoto",
    "productName": "Control OBS Remoto",
    "icon": "build/icon.png",
    "files": [
      "electron-main.js",
      "server.js",
      "package.json",
      "views/**/*",
      "public/**/*",
      "data/himnos.json",
      "data/biblia_rvr1960.json",
      "data/biblia_dhh.json",
      "!data/config.json",
      "!Cantado/**/*",
      "!cantado/**/*",
      "!Instrumental/**/*",
      "!instrumental/**/*",
      "!instrumntal/**/*",
      "!imagenes/**/*"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.utilities",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Control OBS Remoto",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh"
    }
  }
}
